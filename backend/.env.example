# 비워 두면 로컬 기본값/ mock AI로 동작합니다. 실제 값은 .env에만 넣고 커밋하지 마세요.
APP_ENV=development
DATABASE_URL=sqlite:///./agora.db
SESSION_SECRET=
FRONTEND_ORIGIN=http://localhost:5173
PUBLIC_BASE_URL=http://localhost:5173
HYPERCLOVA_API_KEY=
# 냥냥이: HyperCLOVA → EXAONE 키1 → 키2 → Groq Qwen 순서(D-005)
EXAONE_API_KEY=
EXAONE_API_KEY_2=
GEMINI_API_KEY=
GROQ_API_KEY=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
KAKAO_REST_KEY=
KAKAO_CLIENT_SECRET=
CRON_SECRET=
# 배포(Vercel)에서는 true — 앞단이 붙여 주는 X-Forwarded-For로 접속 주소를 읽음
TRUST_PROXY=false
DAILY_USER_LIMIT=3
DAILY_GLOBAL_LIMIT=20
# AI 주제 확인 하루 횟수(거절돼도 셈, Q-017)
DAILY_USER_CHECKS=10
DAILY_GLOBAL_CHECKS=100
